---
layout: base.njk
---
<article>
  <header class="head ruled">
    <h1>{{ title }}</h1>
    <p class="stamp"><time datetime="{{ page.date | iso }}">{{ page.date | stamp }}</time></p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="tombstone" aria-hidden="true"></p>
</article>
